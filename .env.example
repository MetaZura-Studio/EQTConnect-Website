# Copy to .env.local for local development, or set these in your hosting provider.
# NEXT_PUBLIC_* values are embedded at build time — rebuild after changing them.

# --- Site -------------------------------------------------------------------

# Canonical production origin, no trailing slash. Drives canonical URLs, Open Graph
# URLs and sitemap.xml (the sitemap is empty until this is set).
NEXT_PUBLIC_SITE_URL=

# Set to "true" only on the production deployment. Any other value serves
# noindex/nofollow meta tags and a robots.txt that disallows all crawling.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Contact form delivery (configure exactly ONE option) ---------------------
# If neither option is configured, the form shows a "not active yet" notice and the
# API responds 503 — submissions are never discarded silently or reported as sent.
# The contact page is statically rendered, so rebuild after configuring delivery.

# Option A: POST each inquiry as JSON to your CRM / automation webhook.
# Payload: { "type": "demo_request", "submittedAt": ISO-8601, "inquiry": { ... } }
CONTACT_WEBHOOK_URL=
# Optional. Sent as "Authorization: Bearer <secret>".
CONTACT_WEBHOOK_SECRET=

# Option B: send each inquiry as an email via Resend (https://resend.com).
RESEND_API_KEY=
# Comma-separated list of recipients.
CONTACT_TO_EMAIL=
# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=

# --- Bot protection (optional, recommended) -----------------------------------
# Cloudflare Turnstile. Set BOTH keys to enable; the widget and its CSP allowance
# are added only when the site key is present.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
